{
  "schemaVersion": 1,
  "name": "ielts-buddy-agent-skills",
  "version": "0.14.0",
  "description": "基于“躺着学”雅思教研团队长期教学与学员服务实践整理的 IELTS Agent Skills，支持 Codex、Claude Code、Cursor、WorkBuddy 等本地 Agent，持续维护中。",
  "repository": "https://github.com/Jobo16/ielts-buddy",
  "api": {
    "baseUrl": "https://work.ieltsbuddy.igopx.cn/api/v1/agent",
    "auth": "agent_token",
    "script": "scripts/ielts_buddy_api.py",
    "tokenEnv": "IELTS_BUDDY_TOKEN"
  },
  "binding": {
    "endpoint": "https://work.ieltsbuddy.igopx.cn/api/v1/agent-bindings",
    "page": "https://work.ieltsbuddy.igopx.cn/agent/bind",
    "command": "python3 scripts/ielts_buddy_api.py bind",
    "credentialFile": "~/.config/ielts-buddy/agent-token"
  },
  "distribution": {
    "defaultSource": "oss",
    "latestUrl": "https://ieltsbuddy-content.oss-cn-hangzhou.aliyuncs.com/learner-skills/latest.json",
    "downloadUrl": "https://ieltsbuddy-content.oss-cn-hangzhou.aliyuncs.com/learner-skills/ielts-buddy-agent-skills.zip",
    "updaterSkill": "ielts-buddy-skills-updater"
  },
  "skills": [
    {
      "id": "ielts-study-plan",
      "path": "skills/ielts-study-plan",
      "entry": "skills/ielts-study-plan/SKILL.md",
      "name": "学习计划",
      "summary": "诊断、跨技能闭环、每日学习、周复盘与资源推荐。"
    },
    {
      "id": "ielts-practice",
      "path": "skills/ielts-practice",
      "entry": "skills/ielts-practice/SKILL.md",
      "name": "刷题练习",
      "summary": "选一组题、在浏览器完成练习，并交接精读、精听与错题词汇复习。"
    },
    {
      "id": "ielts-writing-review",
      "path": "skills/ielts-writing-review",
      "entry": "skills/ielts-writing-review/SKILL.md",
      "name": "作文批改",
      "summary": "Task 1/2 审题提纲、批改、二改、DOCX 批注与高价值表达交接。"
    },
    {
      "id": "ielts-speaking-coach",
      "path": "skills/ielts-speaking-coach",
      "entry": "skills/ielts-speaking-coach/SKILL.md",
      "name": "口语陪练",
      "summary": "Part 1/2/3 陪练、真实经历串题覆盖、口语报告与表达交接。"
    },
    {
      "id": "ielts-reading-review",
      "path": "skills/ielts-reading-review",
      "entry": "skills/ielts-reading-review/SKILL.md",
      "name": "阅读错题复盘",
      "summary": "原文证据、同义替换、四步精读与阅读词汇手册。"
    },
    {
      "id": "ielts-listening-review",
      "path": "skills/ielts-listening-review",
      "entry": "skills/ielts-listening-review/SKILL.md",
      "name": "听力错题复盘",
      "summary": "听辨错因、逐句精听微练习与错题本。"
    },
    {
      "id": "ielts-vocabulary-coach",
      "path": "skills/ielts-vocabulary-coach",
      "entry": "skills/ielts-vocabulary-coach/SKILL.md",
      "name": "词汇练习",
      "summary": "主动回忆、错题词汇、搭配训练、词汇周复习与数据迁移。"
    },
    {
      "id": "ielts-mock-review",
      "path": "skills/ielts-mock-review",
      "entry": "skills/ielts-mock-review/SKILL.md",
      "name": "模考复盘",
      "summary": "模考结果、失分模式与下一阶段训练重点。"
    },
    {
      "id": "ielts-buddy-skills-updater",
      "path": "skills/ielts-buddy-skills-updater",
      "entry": "skills/ielts-buddy-skills-updater/SKILL.md",
      "name": "Skills 更新",
      "summary": "从固定 OSS 源检查并更新 IELTS Buddy 用户端 Skills。"
    }
  ]
}
