{
  "schemaVersion": 1,
  "name": "ielts-buddy-agent-skills",
  "version": "0.16.0",
  "description": "IELTS Buddy 的本地 Agent 脚本、接口 Skills 与可选工作流，支持 Codex、Claude Code、Cursor、WorkBuddy 等本地 Agent。",
  "repository": "https://github.com/Jobo16/ielts-buddy",
  "api": {
    "baseUrl": "https://work.ieltsbuddy.igopx.cn/api/v1/agent",
    "auth": "agent_token",
    "script": "scripts/ielts_buddy_api.py",
    "tokenEnv": "IELTS_BUDDY_TOKEN"
  },
  "binding": {
    "endpoint": "https://work.ieltsbuddy.igopx.cn/api/v1/agent-bindings",
    "page": "https://work.ieltsbuddy.igopx.cn/agent/bind",
    "command": "python3 scripts/ielts_buddy_api.py bind",
    "credentialFile": "~/.config/ielts-buddy/agent-token"
  },
  "distribution": {
    "defaultSource": "oss",
    "latestUrl": "https://ieltsbuddy-content.oss-cn-hangzhou.aliyuncs.com/learner-skills/latest.json",
    "downloadUrl": "https://ieltsbuddy-content.oss-cn-hangzhou.aliyuncs.com/learner-skills/ielts-buddy-agent-skills.zip",
    "updaterSkill": "ielts-buddy-skills-updater"
  },
  "layers": {
    "scripts": {
      "path": "scripts",
      "purpose": "可复用的 API、数据和文档处理脚本"
    },
    "skills": {
      "path": "skills",
      "purpose": "脚本调用、输入输出数据与权限边界"
    },
    "workflows": {
      "path": "workflows",
      "purpose": "独立的可选推荐用法"
    }
  },
  "skills": [
    {
      "id": "ielts-study-plan",
      "path": "skills/ielts-study-plan",
      "entry": "skills/ielts-study-plan/SKILL.md",
      "name": "学习计划",
      "summary": "读取和写入计划、学习路径、资源与学习事件。"
    },
    {
      "id": "ielts-practice",
      "path": "skills/ielts-practice",
      "entry": "skills/ielts-practice/SKILL.md",
      "name": "刷题练习",
      "summary": "查询预测、题库、浏览器练习 session 与已提交结果。"
    },
    {
      "id": "ielts-buddy-question-research",
      "kind": "api_interface",
      "path": "skills/ielts-buddy-question-research",
      "entry": "skills/ielts-buddy-question-research/SKILL.md",
      "name": "题库数据",
      "summary": "在后台题库权限下读取题库覆盖、目录、材料和标签。"
    },
    {
      "id": "ielts-writing-review",
      "path": "skills/ielts-writing-review",
      "entry": "skills/ielts-writing-review/SKILL.md",
      "name": "作文批改",
      "summary": "读取和保存写作提交与修订记录。"
    },
    {
      "id": "ielts-speaking-coach",
      "path": "skills/ielts-speaking-coach",
      "entry": "skills/ielts-speaking-coach/SKILL.md",
      "name": "口语陪练",
      "summary": "读取和维护当前账号的口语素材与练习入口。"
    },
    {
      "id": "ielts-reading-review",
      "path": "skills/ielts-reading-review",
      "entry": "skills/ielts-reading-review/SKILL.md",
      "name": "阅读错题复盘",
      "summary": "读取已提交阅读练习的结果和按需材料。"
    },
    {
      "id": "ielts-listening-review",
      "path": "skills/ielts-listening-review",
      "entry": "skills/ielts-listening-review/SKILL.md",
      "name": "听力错题复盘",
      "summary": "读取已提交听力练习的结果和按需材料。"
    },
    {
      "id": "ielts-vocabulary-coach",
      "path": "skills/ielts-vocabulary-coach",
      "entry": "skills/ielts-vocabulary-coach/SKILL.md",
      "name": "词汇练习",
      "summary": "读取、维护、导入导出和记录内置及个人词汇数据。"
    },
    {
      "id": "ielts-mock-review",
      "path": "skills/ielts-mock-review",
      "entry": "skills/ielts-mock-review/SKILL.md",
      "name": "模考复盘",
      "summary": "读取模考试卷目录和已产生的活动数据。"
    },
    {
      "id": "ielts-buddy-skills-updater",
      "path": "skills/ielts-buddy-skills-updater",
      "entry": "skills/ielts-buddy-skills-updater/SKILL.md",
      "name": "Skills 更新",
      "summary": "从固定 OSS 源检查并更新用户端 Skills 发行包。"
    }
  ],
  "workflows": [
    {"id": "listening-error-review", "kind": "common", "path": "workflows/common/listening-error-review/WORKFLOW.md", "requiresSkills": []},
    {"id": "mock-test-review", "kind": "common", "path": "workflows/common/mock-test-review/WORKFLOW.md", "requiresSkills": []},
    {"id": "diagnostic-baseline", "kind": "common", "path": "workflows/common/diagnostic-baseline/WORKFLOW.md", "requiresSkills": []},
    {"id": "learning-resource-recommender", "kind": "common", "path": "workflows/common/learning-resource-recommender/WORKFLOW.md", "requiresSkills": []},
    {"id": "weekly-study-review", "kind": "common", "path": "workflows/common/weekly-study-review/WORKFLOW.md", "requiresSkills": []},
    {"id": "writing-revision-loop", "kind": "common", "path": "workflows/common/writing-revision-loop/WORKFLOW.md", "requiresSkills": []},
    {"id": "writing-task-planning", "kind": "common", "path": "workflows/common/writing-task-planning/WORKFLOW.md", "requiresSkills": []},
    {"id": "oss-skills-update", "kind": "skill_enabled", "path": "workflows/skill-enabled/oss-skills-update/WORKFLOW.md", "requiresSkills": ["ielts-buddy-skills-updater"]},
    {"id": "intensive-listening", "kind": "skill_enabled", "path": "workflows/skill-enabled/intensive-listening/WORKFLOW.md", "requiresSkills": ["ielts-practice", "ielts-vocabulary-coach"]},
    {"id": "browser-practice", "kind": "skill_enabled", "path": "workflows/skill-enabled/browser-practice/WORKFLOW.md", "requiresSkills": ["ielts-practice"]},
    {"id": "objective-result-review", "kind": "skill_enabled", "path": "workflows/skill-enabled/objective-result-review/WORKFLOW.md", "requiresSkills": ["ielts-practice"]},
    {"id": "reading-lexicon", "kind": "skill_enabled", "path": "workflows/skill-enabled/reading-lexicon/WORKFLOW.md", "requiresSkills": ["ielts-vocabulary-coach"]},
    {"id": "intensive-reading", "kind": "skill_enabled", "path": "workflows/skill-enabled/intensive-reading/WORKFLOW.md", "requiresSkills": ["ielts-practice", "ielts-vocabulary-coach"]},
    {"id": "reading-review", "kind": "skill_enabled", "path": "workflows/skill-enabled/reading-review/WORKFLOW.md", "requiresSkills": ["ielts-practice"]},
    {"id": "speaking-coach", "kind": "skill_enabled", "path": "workflows/skill-enabled/speaking-coach/WORKFLOW.md", "requiresSkills": ["ielts-vocabulary-coach"]},
    {"id": "speaking-coverage-map", "kind": "skill_enabled", "path": "workflows/skill-enabled/speaking-coverage-map/WORKFLOW.md", "requiresSkills": ["ielts-practice", "ielts-speaking-coach"]},
    {"id": "speaking-topic-builder", "kind": "skill_enabled", "path": "workflows/skill-enabled/speaking-topic-builder/WORKFLOW.md", "requiresSkills": ["ielts-practice", "ielts-speaking-coach"]},
    {"id": "daily-study-loop", "kind": "skill_enabled", "path": "workflows/skill-enabled/daily-study-loop/WORKFLOW.md", "requiresSkills": ["ielts-study-plan", "ielts-practice", "ielts-vocabulary-coach"]},
    {"id": "evidence-to-next-action", "kind": "skill_enabled", "path": "workflows/skill-enabled/evidence-to-next-action/WORKFLOW.md", "requiresSkills": ["ielts-practice", "ielts-study-plan"]},
    {"id": "vocabulary-session", "kind": "skill_enabled", "path": "workflows/skill-enabled/vocabulary-session/WORKFLOW.md", "requiresSkills": ["ielts-practice", "ielts-vocabulary-coach"]},
    {"id": "ielts-task1-review", "kind": "skill_enabled", "path": "workflows/skill-enabled/ielts-task1-review/WORKFLOW.md", "requiresSkills": ["ielts-vocabulary-coach", "ielts-writing-review"]},
    {"id": "ielts-task2-review", "kind": "skill_enabled", "path": "workflows/skill-enabled/ielts-task2-review/WORKFLOW.md", "requiresSkills": ["ielts-vocabulary-coach", "ielts-writing-review"]}
  ]
}
