                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "entityId",
              "kind",
              "title",
              "occurredAt",
              "metrics"
            ],
            "additionalProperties": {}
          },
          "description": "本页时间线。条数由 limit 限制，不代表完整历史或学习次数。"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "当前 kinds/query/timeRange 筛选下的完整展示活动数。"
        },
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
