                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceTruncated": {
              "type": "boolean"
            }
          },
          "required": [
            "sourceLimit",
            "sourceTruncated"
          ],
          "additionalProperties": false,
          "description": "完整查询返回 sourceLimit=null、sourceTruncated=false；旧服务如报告截断则不得声称查全。"
        },
        "asOf": {
          "type": "string",
