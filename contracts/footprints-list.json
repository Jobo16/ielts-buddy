{
  "id": "footprints.list",
  "operationName": "ielts_footprints_list",
  "requestSchema": {
    "type": "object",
    "properties": {
      "cursor": {
        "description": "Continue with nextCursor from the preceding page; leave absent on the first page.",
        "type": "string",
        "maxLength": 1024
      },
      "kinds": {
        "default": [],
        "description": "Activity kinds to include. Empty includes all kinds.",
        "maxItems": 6,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "chat",
            "file",
            "mock",
            "note",
            "practice",
            "study"
          ]
        }
      },
      "limit": {
        "default": 20,
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "offset": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "query": {
        "default": "",
        "description": "Title or description search query.",
        "type": "string"
      },
      "timeRange": {
        "default": "all",
        "type": "string",
        "enum": [
          "all",
          "today",
          "7d",
          "30d"
        ]
      }
    },
    "required": [
      "kinds",
      "limit",
      "offset",
      "query",
      "timeRange"
    ],
    "additionalProperties": false
  },
  "response": {
    "description": "data 返回时间线分页和独立统计；统计覆盖当前筛选下的全部历史，不能用 activities.length 重算。",
    "notes": [
      "首次请求省略 cursor；后续把 nextCursor 原样作为 cursor，并保持 kinds/query/timeRange 不变。hasMore=false 才表示该查询已读完。查询统计无需先拉完时间线。",
      "summary、dailyCounts、todayCounts 均按 Asia/Shanghai 计算，statisticsScope=filtered_history；total 是展示活动总数，activities 只是当前页。",
      "同用户、同课程、同章节、同上海日期的视频开始/进度/完成合为一条活动，保留首次时间、最后时间、最高播放位置及完成状态；原始事件不删除。词汇事件只在同对象、同日期内折叠。",
      "footprints.list 查询跨产品展示足迹；learning.events.pull 按独立的数字 cursor 同步原始学习证据，两者条数不应直接比较。Agent 不应通过补写事件修复网页显示。"
    ],
    "dataSchema": {
      "type": "object",
      "properties": {
        "activities": {
          "type": "array",
